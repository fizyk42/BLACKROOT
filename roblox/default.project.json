{
  "name": "BLACKROOT",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Blackroot": {
        "$path": "src/ServerScriptService/Blackroot"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "$path": "src/ServerStorage"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "ClockTime": 7.2,
        "Brightness": 2.4,
        "Ambient": [0.19, 0.2, 0.23],
        "OutdoorAmbient": [0.36, 0.38, 0.42],
        "EnvironmentDiffuseScale": 0.55,
        "EnvironmentSpecularScale": 0.4,
        "GlobalShadows": true,
        "FogEnd": 900,
        "FogStart": 120,
        "Technology": "Future"
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 4
      }
    }
  }
}
